---
import type { Project } from "../../data/projects";
import DisplayGrid from "../picture-grid/DisplayGrid.astro";
import ProjectModal from "../projects/ProjectModal.astro";

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { title, img, gif, color, border } = project;
---

<div class="project-display min-w-0 pb-4" style={`--display-color: ${color}`}>
  <DisplayGrid {color} {border}>
    <!-- Project image -->
    <button
      slot="content"
      type="button"
      class="open-button group relative block
        min-w-0 w-full overflow-hidden"
      aria-label={`Open ${title}`}
    >
      <img
        src={img}
        alt={`An image depicting ${title}`}
        class="block h-auto w-full"
      />

      <img
        src={gif}
        alt=""
        aria-hidden="true"
        class="absolute inset-0 hidden h-full w-full
          object-contain opacity-0
          transition-opacity duration-300
          sm:block sm:group-hover:opacity-100"
      />
    </button>

    <!-- Project title -->
    <button
      slot="footer"
      type="button"
      class="open-button flex h-full min-w-0 w-full
        items-center justify-center
        border border-(--display-color)/60
        bg-(--secondary)/90
        px-2
        text-center text-xl font-extrabold text-black text-shadow-md/20
        hover:border-(--display-color)/70
        hover:bg-(--secondary)
        sm:text-lg"
      aria-label={`Open ${title}`}
    >
      {title}
    </button>
  </DisplayGrid>

  <ProjectModal {project} />
</div>

<script>
  document
    .querySelectorAll<HTMLElement>(".project-display")
    .forEach((display) => {
      const modal = display.querySelector<HTMLElement>(".modal-popup");
      const closeButton =
        display.querySelector<HTMLButtonElement>(".close-button");
      const openButtons =
        display.querySelectorAll<HTMLButtonElement>(".open-button");
      const modalParent = modal?.parentElement;

      if (!modal || !closeButton || !modalParent) return;

      let returnFocusTo: HTMLButtonElement | null = null;
      let navbarWasHidden = false;

      const closeModal = () => {
        if (modal.classList.contains("hidden")) return;

        modal.classList.add("hidden");
        modal.classList.remove("flex");
        modal.setAttribute("aria-hidden", "true");

        modalParent.append(modal);

        const navbar = document.querySelector<HTMLElement>("#site-navbar");

        if (navbar && !navbarWasHidden) {
          navbar.classList.remove("hidden");
        }

        document.body.classList.remove("modal-open");
        document.documentElement.classList.remove("modal-open");

        returnFocusTo?.focus();
      };

      const openModal = (button: HTMLButtonElement) => {
        returnFocusTo = button;

        const navbar = document.querySelector<HTMLElement>("#site-navbar");

        navbarWasHidden = navbar?.classList.contains("hidden") ?? false;

        document.body.append(modal);

        modal.classList.remove("hidden");
        modal.classList.add("flex");
        modal.setAttribute("aria-hidden", "false");

        navbar?.classList.add("hidden");

        document.body.classList.add("modal-open");
        document.documentElement.classList.add("modal-open");

        closeButton.focus();
      };

      openButtons.forEach((button) => {
        button.addEventListener("click", () => openModal(button));
      });

      closeButton.addEventListener("click", closeModal);

      modal.addEventListener("click", (event) => {
        if (event.target === modal) {
          closeModal();
        }
      });

      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && !modal.classList.contains("hidden")) {
          closeModal();
        }
      });
    });
</script>
