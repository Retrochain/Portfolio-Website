---
import PanelHeader from "./PanelHeader.astro";

interface Props {
  title: string;
  list: string[];
}

const { title, list } = Astro.props;
---

<div class="flex flex-col min-w-0">
  <PanelHeader
    label={title}
    width="w-4/5 sm:w-4/5 md:w-5/7 lg:w-3/5"
  />
  <div
    class="flex min-h-0 flex-col border border-(--primary)/60 bg-(--grid)/40 p-5 text-xl font-bold wrap-break-word"
  >
    <ul class="list-none">
      {list.map((item) => <li><span aria-hidden="true">- </span>{item}</li>)}
    </ul>
  </div>
</div>
