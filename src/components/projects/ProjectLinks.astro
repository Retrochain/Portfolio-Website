---
interface Props {
  github?: string | string[];
  demo?: string;
  title: string;
  color: string;
}

const { github, demo, title, color } = Astro.props;

const githubLinks = github ? (Array.isArray(github) ? github : [github]) : [];
---

<div class="grid shrink-0 gap-3" style={`--display-color: ${color}`}>
  <!-- We create a clickable link for github links for the current project -->

  {
    githubLinks.map((url, index) => (
      <a
        href={url}
        target="_blank"
        rel="noopener noreferrer"
        class="flex min-h-10 w-full min-w-0 items-center justify-center overflow-hidden border border-(--display-color)/60 bg-(--secondary)/90 px-2 text-center text-xl font-extrabold text-black hover:border-(--display-color)/70 hover:bg-(--secondary) sm:text-lg"
        aria-label={`Open GitHub repository ${index + 1} for ${title}`}
      >
        GitHub Repo{githubLinks.length > 1 ? ` ${index + 1}` : ""} -&gt;
      </a>
    ))
  }

  <!-- And another link for the live view of the current project -->

  {
    demo && (
      <a
        href={demo}
        target="_blank"
        rel="noopener noreferrer"
        class="flex min-h-10 w-full min-w-0 items-center justify-center overflow-hidden border border-(--display-color)/60 bg-(--secondary)/90 px-2 text-center text-xl font-extrabold text-black hover:border-(--display-color)/70 hover:bg-(--secondary) sm:text-lg"
        aria-label={`Open live website for ${title}`}
      >
        Live Website -&gt;
      </a>
    )
  }
</div>
