---
import type { Project } from "../../data/projects";

import DisplayFrame from "../picture-grid/DisplayFrame.astro";
import PanelHeader from "../ui/PanelHeader.astro";
import ProjectDetails from "./ProjectDetails.astro";
import ProjectLinks from "./ProjectLinks.astro";

interface Props {
  project: Project;
}

const { project } = Astro.props;

const {
  number,
  title,
  img,
  color,
  border,
  overview,
  technologies,
  features,
  status,
  type,
  duration,
} = project;

const underscoredTitle = title.replace(/\s+/g, "_");
const modalId = `project-modal-${project.id}`;
const titleId = `${modalId}-title`;
---

<div
  id={modalId}
  role="dialog"
  aria-modal="true"
  aria-hidden="true"
  aria-labelledby={titleId}
  class="modal-popup fixed inset-0 z-90 hidden
    items-start justify-center
    overflow-y-auto overflow-x-hidden
    bg-black/80 p-2
    sm:p-4
    lg:items-center"
>
  <div class="flex w-full min-w-0 max-w-7xl flex-col items-start">
    <!-- Modal header -->
    <PanelHeader
      label="//PROJECT_NODE_DISP"
      {color}
      width="w-3/4 sm:w-2/3 md:w-2/5 lg:w-1/4"
    />

    <!-- Modal body -->
    <div
      class="relative grid min-h-max w-full min-w-0
        grid-cols-1 gap-4
        border border-(--primary)/70
        bg-(--grid)/70
        p-3 shadow-2xl/40
        sm:p-4 md:p-5
        lg:h-[85dvh]
        lg:min-h-0 lg:max-h-[92dvh]
        lg:grid-cols-[minmax(0,3fr)_minmax(0,1fr)]
        lg:overflow-hidden"
    >
      <!-- Close -->
      <button
        type="button"
        class="close-button absolute right-2 top-2 z-20
          flex h-8 w-8 items-center justify-center
          border-2 border-red-900
          bg-red-600/80 text-sm
          hover:bg-red-700/80"
        aria-label="Close project modal"
      >
        X
      </button>

      <!-- LEFT COLUMN -->
      <section
        class="grid min-w-0 w-full
          grid-rows-[auto_auto_auto]
          gap-3 pt-8
          lg:min-h-0
          lg:grid-rows-[auto_minmax(0,3fr)_minmax(0,2fr)]
          lg:gap-4 lg:pt-0"
      >
        <!-- Title -->
        <h3
          id={titleId}
          class="min-w-0 max-w-full
            wrap-break-word
            text-3xl font-extrabold
            uppercase text-(--secondary)
            sm:text-4xl
            lg:text-5xl"
        >
          0{number}/{underscoredTitle}
        </h3>

        <!-- Image -->
        <DisplayFrame {color} {border} class="lg:min-h-0">
          <div
            class="relative h-[30vh] min-h-40 w-full
              sm:h-[35vh]
              lg:h-full"
          >
            <img
              src={img}
              alt={`An image depicting ${title}`}
              class="block h-full w-full object-contain"
            />
          </div>
        </DisplayFrame>

        <!-- Overview -->
        <section
          class="grid min-w-0 w-full
            lg:min-h-0
            lg:grid-rows-[auto_minmax(0,1fr)]"
        >
          <PanelHeader
            label="//OVERVIEW"
            {color}
            width="w-1/2 sm:w-2/3 md:w-2/5 lg:w-1/6"
          />

          <div
            class="min-h-0 min-w-0 w-full
              border border-(--display-color)/60
              bg-(--grid)/40
              p-3
              sm:p-4
              lg:overflow-y-auto lg:p-5"
            style={`--display-color: ${color}`}
          >
            <p
              class="wrap-break-word
                text-lg font-bold
                leading-6 text-(--text)
                sm:text-md"
            >
              {overview}
            </p>
          </div>
        </section>
      </section>

      <!-- RIGHT COLUMN -->
      <section
        class="grid min-h-0 min-w-0 w-full
          grid-rows-[auto_minmax(0,1fr)]"
      >
        <PanelHeader
          label="//PROJECT_INFO"
          {color}
          width="w-3/5 sm:w-2/3 md:w-2/5 lg:w-3/4"
        />

        <div
          class="min-h-0 min-w-0 w-full
            overflow-hidden
            border border-(--display-color)/40
            bg-(--grid)/60
            p-2
            sm:p-3"
          style={`--display-color: ${color}`}
        >
          <div class="flex h-full min-h-0 flex-col gap-3">
            <ProjectDetails
              {technologies}
              {features}
              {status}
              {type}
              {duration}
              {color}
            />

            <ProjectLinks
              github={project.github}
              demo={project.demo}
              {title}
              {color}
            />
          </div>
        </div>
      </section>
    </div>
  </div>
</div>
