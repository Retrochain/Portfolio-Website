---
import SkillCard from "../ui/SkillCard.astro";
import PlusDecoration from "../stylization/Plus.astro";
import ContentBox from "../ui/ContentBox.astro";
import Barcode from "../stylization/Barcode.astro";
import SectionHeader from "../ui/SectionHeader.astro";
import InfoPanel from "../ui/InfoPanel.astro";
---

<div
  id="skills"
  class="relative overflow-hidden pt-12 pb-18 mx-auto min-h-90vh w-19/20 pl-4 pr-4 text-shadow-md/20"
>
  <SectionHeader
    title="SKILLS"
    subtitle="//Skillsets I have acquired over the years"
  />
  <div class="text-(--decor)">
    <Barcode bottom={20} right={60} />
  </div>

  <h2
    class="pointer-events-none absolute select-none text-(--text)/20 font-extrabold -right-95 md:right-0 -top-15 text-[12rem] z-5"
  >
    SKILLS
  </h2>
  <h4 class="absolute select-none right-0 md:left-4 top-0 whitespace-nowrap text-[1.5rem] text-(--decor) z-5">
    //INIT_SKILL
  </h4>

  <div class="hidden lg:block">
    <ContentBox
      bottom={80}
      left={40}
      barcode={false}
      text={"SKILLS.........................40%" +
        "\nLOAD_NODES..............10%" +
        "\nDISP_INFO...................80%" +
        "\nUPDATE_CHECK.........60%"}
    />
  </div>

  <!-- Decorative plus signs based on screen size -->
  <div class="lg:block hidden">
    <PlusDecoration bottom={35} left={250} size={20} />
    <PlusDecoration bottom={35} left={275} size={20} />
    <PlusDecoration bottom={35} left={300} size={20} />
    <PlusDecoration bottom={35} left={350} size={20} />
    <PlusDecoration bottom={35} left={375} size={20} />
    <PlusDecoration bottom={35} left={400} size={20} />
    <PlusDecoration bottom={35} left={425} size={20} />
    <PlusDecoration bottom={60} left={200} size={20} />
    <PlusDecoration bottom={60} left={250} size={20} />
    <PlusDecoration bottom={60} left={275} size={20} />
    <PlusDecoration bottom={60} left={325} size={20} />
    <PlusDecoration bottom={60} left={350} size={20} />
    <PlusDecoration bottom={60} left={400} size={20} />
    <PlusDecoration bottom={85} left={225} size={20} />
    <PlusDecoration bottom={85} left={325} size={20} />
    <PlusDecoration bottom={85} left={375} size={20} />
    <PlusDecoration bottom={85} left={425} size={20} />

    <PlusDecoration top={25} right={250} size={20} />
    <PlusDecoration top={25} right={275} size={20} />
    <PlusDecoration top={25} right={375} size={20} />
    <PlusDecoration top={50} right={200} size={20} />
    <PlusDecoration top={50} right={225} size={20} />
    <PlusDecoration top={50} right={250} size={20} />
    <PlusDecoration top={50} right={275} size={20} />
    <PlusDecoration top={50} right={325} size={20} />
    <PlusDecoration top={50} right={375} size={20} />
    <PlusDecoration top={75} right={225} size={20} />
    <PlusDecoration top={75} right={275} size={20} />
    <PlusDecoration top={75} right={300} size={20} />
    <PlusDecoration top={75} right={325} size={20} />
    <PlusDecoration top={75} right={350} size={20} />
    <PlusDecoration top={75} right={375} size={20} />
    <PlusDecoration top={75} right={400} size={20} />
    <PlusDecoration top={100} right={300} size={20} />
    <PlusDecoration top={100} right={375} size={20} />
    <PlusDecoration top={100} right={425} size={20} />
    <PlusDecoration top={100} right={450} size={20} />
    <PlusDecoration top={125} right={425} size={20} />
    <PlusDecoration top={150} right={425} size={20} />
  </div>

  <div class="block lg:hidden">
    <div
      class="absolute top-160 right-0 w-[80%] h-3/4 -z-1
      bg-[radial-gradient(var(--primary)_1px,transparent_1px)] bg-size-[56px_56px]"
    >
    </div>
    <PlusDecoration top={10} left={25} size={20} />
    <PlusDecoration top={10} left={50} size={20} />
    <PlusDecoration top={35} left={0} size={20} />
    <PlusDecoration top={35} left={25} size={20} />
    <PlusDecoration top={35} left={50} size={20} />
    <PlusDecoration top={35} left={75} size={20} />
    <PlusDecoration top={60} left={0} size={20} />
    <PlusDecoration top={85} left={0} size={20} />

    <PlusDecoration bottom={10} left={25} size={20} />
    <PlusDecoration bottom={10} left={50} size={20} />
    <PlusDecoration bottom={35} left={0} size={20} />
    <PlusDecoration bottom={35} left={25} size={20} />
    <PlusDecoration bottom={35} left={50} size={20} />
    <PlusDecoration bottom={35} left={75} size={20} />
    <PlusDecoration bottom={60} left={0} size={20} />
    <PlusDecoration bottom={85} left={0} size={20} />
  </div>
  <div class="absolute w-4 h-4 aspect-square bottom-0 left-0 bg-(--primary)">
  </div>
  <div
    class="absolute block bottom-2 right-0 sm:right-30 w-full h-px bg-(--primary) pointer-events-none"
  >
  </div>
  <div
    class="absolute hidden sm:block bottom-2 right-0 w-22 h-px bg-(--primary) pointer-events-none"
  >
  </div>
  <div
    class="absolute hidden sm:block bottom-0 right-10 w-22 h-px bg-(--primary) pointer-events-none"
  >
  </div>

  <div
    class="grid grid-cols-1 gap-6 lg:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] drop-shadow-md"
  >
    <div class="flex min-w-0 flex-col">
      <InfoPanel title="//SKILL_INFO" headerClip="tl">
        As a Computer Science graduate from The University of Texas at Dallas, I
        have developed a strong foundation in software development and
        problem-solving. My skillset spans frontend and backend development,
        databases, UI/UX, cloud technologies, and AI tools. I like to build
        responsive, user-focused applications across the frontend, backend, and
        data layers, with an interest in scalable systems, AI-assisted
        development, and clean software architecture. I am always eager to learn
        and adapt to new technologies, aiming to continuously improve my skills
        and contribute effectively to any development team.
      </InfoPanel>
      <a
        href="/Akshaan_Resume_2026.pdf"
        target="_blank"
        rel="noopener noreferrer"
        class="flex max-h-10 items-center justify-center text-center border-2 border-(--secondary) bg-(--secondary)/90 hover:bg-(--secondary) text-black font-extrabold text-2xl py-2 [clip-path:polygon(0%_0%,100%_0%,90%_100%,0%_100%)] sm:col-span-2 lg:col-span-1 mt-3"
        aria-label={`Open Resume`}>//RESUME</a
      >
    </div>
    <div
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 min-w-0 gap-6 uppercase"
    >
      <SkillCard
        title="FRONTEND"
        list={[
          "React/Angular/Vue.js",
          "Next.js/Astro",
          "Tailwind CSS/Bootstrap CSS",
          "TypeScript/JavaScript",
          "Responsive Design",
          "Mobile First Development",
        ]}
      />
      <SkillCard
        title="BACKEND"
        list={[
          "Node.js/Express.js",
          "Django/Flask",
          "RESTful APIs",
          "HTTP/HTTPS/AXIOS/Fetch",
          "MVC Architecture",
          "API Development",
        ]}
      />
      <SkillCard
        title="DATABASE"
        list={[
          "MySQL/PostgreSQL",
          "Microsoft SQL Server",
          "MongoDB/Redis",
          "Supabase/MySQL Workbench",
          "CRUD Operations/Normalization",
          "Data Modeling/Schema Design",
        ]}
      />
      <SkillCard
        title="AI TOOLS"
        list={[
          "Gen AI/LLMs",
          "ChatGPT/Claude/Copilot",
          "Prompt Engineering",
          "RAG/MCP Integrations",
          "Machine Learning Fundamentals",
          "NumPy/Scikit-learn/Pandas",
        ]}
      />
      <SkillCard
        title="UI/UX"
        list={[
          "Figma/Adobe XD",
          "Wireframing/Prototyping",
          "Design Systems",
          "USer-Centered Research & Design",
          "Accessible/Inclusive Design",
          "Design Fundamentals",
        ]}
      />
      <SkillCard
        title="MISC."
        list={[
          "Git/GitHub/VCS",
          "Visual Studio Code & Basic",
          "Agile/Scrum",
          "AWS/Azure/Docker",
          "CI/CD Integrations",
          "Cloud Fundamentals",
        ]}
      />
    </div>
  </div>
</div>

<style>
  h2 {
    font-family: var(--font-heading);
  }
</style>
