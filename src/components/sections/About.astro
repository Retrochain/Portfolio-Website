---
import Barcode from "../stylization/Barcode.astro";
import PlusDecoration from "../stylization/Plus.astro";

import DetailCard from "../ui/DetailCard.astro";
import SectionHeader from "../ui/SectionHeader.astro";
import InfoPanel from "../ui/InfoPanel.astro";

import DisplayGrid from "../picture-grid/DisplayGrid.astro";
---

<div
  id="about"
  class="relative mx-auto min-h-[90vh] w-19/20
    overflow-hidden
    pt-12 pb-18"
>
  <!-- Decorative lines -->
  <div
    class="pointer-events-none absolute left-4 top-27 h-px w-64 bg-(--primary)"
  >
  </div>

  <div
    class="pointer-events-none absolute left-16 top-28 h-px w-64 bg-(--primary)"
  >
  </div>

  <div
    class="pointer-events-none absolute bottom-6 right-4 h-px w-full bg-(--primary)"
  >
  </div>

  <div
    class="pointer-events-none absolute bottom-6 right-2 h-160 w-px
      bg-(--primary)
      md:h-120
      lg:h-full"
  >
  </div>

  <div
    class="pointer-events-none absolute bottom-6 left-2 h-160 w-px
      bg-(--primary)
      md:hidden"
  >
  </div>

  <!-- Decorative squares -->
  <div
    class="absolute right-0 top-0 hidden aspect-square h-4 w-4
      bg-(--primary)
      lg:block"
  >
  </div>

  <div class="absolute bottom-4 right-0 aspect-square h-4 w-4 bg-(--primary)">
  </div>

  <div class="absolute bottom-4 left-0 aspect-square h-4 w-4 bg-(--primary)">
  </div>

  <!-- Decorative labels -->
  <h4
    class="absolute bottom-7 right-4
      whitespace-nowrap text-[1.5rem] text-(--decor)"
  >
    //INFO_SEC_INIT
  </h4>

  <h4
    class="absolute right-2 top-2
      whitespace-nowrap text-[1.5rem] text-(--decor)
      md:right-6 md:top-6"
  >
    //DISP_PROFILE
  </h4>

  <div class="hidden text-(--decor) md:block">
    <Barcode top={64} right={24} rotated={false} />
  </div>

  <!-- Desktop plus decorations -->
  <div class="hidden md:block">
    <PlusDecoration bottom={35} left={525} size={20} />
    <PlusDecoration bottom={35} left={550} size={20} />
    <PlusDecoration bottom={35} left={575} size={20} />
    <PlusDecoration bottom={35} left={600} size={20} />
    <PlusDecoration bottom={35} left={625} size={20} />

    <PlusDecoration bottom={60} left={500} size={20} />
    <PlusDecoration bottom={60} left={525} size={20} />
    <PlusDecoration bottom={60} left={550} size={20} />
    <PlusDecoration bottom={60} left={575} size={20} />

    <PlusDecoration bottom={85} left={525} size={20} />
    <PlusDecoration bottom={85} left={550} size={20} />

    <PlusDecoration top={25} right={350} size={20} />
    <PlusDecoration top={25} right={375} size={20} />

    <PlusDecoration top={50} right={325} size={20} />
    <PlusDecoration top={50} right={350} size={20} />
    <PlusDecoration top={50} right={375} size={20} />
    <PlusDecoration top={50} right={400} size={20} />
    <PlusDecoration top={50} right={425} size={20} />

    <PlusDecoration top={75} right={275} size={20} />
    <PlusDecoration top={75} right={300} size={20} />
    <PlusDecoration top={75} right={325} size={20} />
    <PlusDecoration top={75} right={350} size={20} />
    <PlusDecoration top={75} right={375} size={20} />
    <PlusDecoration top={75} right={400} size={20} />

    <PlusDecoration top={100} right={325} size={20} />
    <PlusDecoration top={100} right={350} size={20} />
    <PlusDecoration top={100} right={400} size={20} />

    <PlusDecoration top={125} right={325} size={20} />
  </div>

  <!-- Mobile plus decorations -->
  <div class="md:hidden">
    <PlusDecoration bottom={800} left={25} size={20} />
    <PlusDecoration bottom={800} left={50} size={20} />

    <PlusDecoration bottom={775} left={25} size={20} />
    <PlusDecoration bottom={775} left={50} size={20} />
    <PlusDecoration bottom={775} left={75} size={20} />

    <PlusDecoration bottom={750} left={0} size={20} />
    <PlusDecoration bottom={750} left={25} size={20} />

    <PlusDecoration bottom={725} left={0} size={20} />
    <PlusDecoration bottom={725} left={25} size={20} />

    <PlusDecoration top={45} right={50} size={20} />
    <PlusDecoration top={45} right={75} size={20} />
    <PlusDecoration top={45} right={100} size={20} />

    <PlusDecoration top={70} right={25} size={20} />
    <PlusDecoration top={70} right={50} size={20} />
    <PlusDecoration top={70} right={75} size={20} />

    <PlusDecoration top={95} right={50} size={20} />
    <PlusDecoration top={95} right={75} size={20} />

    <PlusDecoration top={120} right={50} size={20} />
  </div>

  <!-- Decorative dot grid -->
  <div
    class="absolute left-32 top-208 -z-1
      h-20 w-2/3
      bg-[radial-gradient(var(--primary)_1px,transparent_1px)]
      bg-size-[8px_8px]
      md:left-80 md:top-20
      md:h-32 md:w-1/3
      md:bg-[radial-gradient(var(--primary)_1px,transparent_1px)]
      md:bg-size-[16px_16px]"
  >
  </div>

  <!-- Section heading -->
  <SectionHeader title="ABOUT ME" />

  <!-- Main content -->
  <div
    class="relative z-10 grid items-start gap-6
      lg:grid-cols-[minmax(18rem,1fr)_minmax(20rem,1.2fr)_minmax(12rem,0.9fr)]
      2xl:grid-cols-[minmax(18rem,28rem)_minmax(20rem,1.2fr)_minmax(12rem,22rem)]"
  >
    <!-- Profile image -->
    <DisplayGrid color="var(--primary)">
      <img
        slot="content"
        src="/about-me-pic.jpg"
        alt="A picture depicting the author of the website wearing an orange turban holding a bouquet of flowers during their UTD graduation."
        class="block h-auto w-full object-contain object-center"
      />

      <div
        slot="footer"
        data-augmented-ui="br-clip-x b-rect border"
        class="h-full w-full bg-(--display-color)/40"
        style="--aug-border-all: 2px; --aug-border-bg: var(--display-color)"
      >
      </div>
    </DisplayGrid>

    <!-- Biography -->
    <InfoPanel
      title="//BIOGRAPHY"
      footer="//BIO_NODE"
      headerClip="tr"
      footerClip="bl-clip-x br-clip border"
    >
      <p>
        Lorem ipsum dolor sit amet, consectetur adipiscing elit. Praesent lectus
        erat, ornare vitae efficitur ut, vehicula sit amet diam. Donec aliquam
        leo lacus.
      </p>

      <p class="mt-4">
        In nulla risus, ultricies nec suscipit ac, lobortis et ante. Aenean
        commodo sapien ligula, sit amet suscipit velit mattis et.
      </p>
    </InfoPanel>

    <!-- Resume + details -->
    <div
      class="mr-8 ml-8 grid min-w-0 grid-cols-1
        content-start gap-3 uppercase
        sm:grid-cols-2
        md:ml-0
        lg:grid-cols-1"
    >
      <!-- Resume -->
      <a
        href="/Akshaan_Resume_2026.pdf"
        target="_blank"
        rel="noopener noreferrer"
        class="flex max-h-10 items-center justify-center
          border-2 border-(--secondary)
          bg-(--secondary)/90
          py-2
          text-center text-2xl font-extrabold text-black
          hover:bg-(--secondary)
          [clip-path:polygon(10%_0%,90%_0%,100%_100%,0%_100%)]
          sm:col-span-2
          lg:col-span-1"
        aria-label="Open Resume"
      >
        //RESUME
      </a>

      <!-- Basic information -->
      <DetailCard
        items={[
          { label: "Name", value: "AKSHAAN SINGH" },
          { label: "Location", value: "Coppell, TX" },
          { label: "DOB", value: "May 6th, 2003" },
          { label: "Age", value: "23" },
        ]}
      />

      <!-- Contact information -->
      <DetailCard
        items={[
          { label: "Email", value: "akshaansingh.2018@gmail.com" },
          { label: "Phone", value: "+1 (510) 458-9512" },
          {
            label: "LinkedIn",
            value: "Click for LinkedIn",
            href: "https://www.linkedin.com/in/akshaan-singh-2b4086255",
          },
          {
            label: "GitHub",
            value: "Click for GitHub",
            href: "https://github.com/Retrochain/",
          },
        ]}
      />

      <!-- Interests -->
      <DetailCard
        items={[
          {
            label: "Interests",
            value: "Star Wars, Marvel/DC, Scott Pilgrim, Cyberpunk",
          },
          { label: "Fav Game", value: "Cyberpunk 2077" },
          { label: "Fav Movie", value: "Scott Pilgrim Vs The World" },
          { label: "Fav Show", value: "Andor" },
        ]}
      />
    </div>
  </div>
</div>

<style>
  h2 {
    font-family: var(--font-heading);
  }

  .about-details {
    position: relative;
  }

  .about-details::after {
    content: "";
    position: absolute;
    inset: -2px;
    pointer-events: none;

    background:
      linear-gradient(var(--decor), var(--decor)) top left / 1.5rem 3px,
      linear-gradient(var(--decor), var(--decor)) top left / 3px 1.5rem,
      linear-gradient(var(--decor), var(--decor)) top right / 1.5rem 3px,
      linear-gradient(var(--decor), var(--decor)) top right / 3px 1.5rem,
      linear-gradient(var(--decor), var(--decor)) bottom left / 1.5rem 3px,
      linear-gradient(var(--decor), var(--decor)) bottom left / 3px 1.5rem,
      linear-gradient(var(--decor), var(--decor)) bottom right / 1.5rem 3px,
      linear-gradient(var(--decor), var(--decor)) bottom right / 3px 1.5rem;

    background-repeat: no-repeat;
  }
</style>
