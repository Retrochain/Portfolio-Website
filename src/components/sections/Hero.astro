---
import PlusDecoration from "../stylization/Plus.astro";
import ContentBox from "../stylization/ContentBox.astro";
import Barcode from "../stylization/Barcode.astro";
---

<!-- This is the main hero page, aka the landing page --><!-- We first cover the visible screen with a picture -->
<div
  id="home"
  class="w-full h-[85vh] md:h-screen overflow-x-hidden bg-[url('/night-city-bg.jpg')] bg-cover bg-center text-shadow-lg/30"
>
  <!-- We then cover the picture with a box with a linear gradient -->
  <div
    class="relative box-border flex w-full h-full flex-col items-start justify-end bg-linear-to-r from-black to-black/55 p-3 md:p-16"
  >
    <!-- Using a custom component we can create a box to display some text -->
    <!-- Desktop Version -->
    <div class="hidden lg:block">
      <ContentBox
        top={20}
        left={20}
        barcode={true}
        text={"SYS LVL.............70%" +
          "\nSTATS................20%" +
          "\nCOOLING LVL...30%" +
          "\nDAEMON...........40%"}
      />

      <!-- Another customer component to place some pluses -->
      <PlusDecoration top={20} left={180} size={20} />
      <PlusDecoration top={20} left={205} size={20} />
      <PlusDecoration top={20} left={230} size={20} />
      <PlusDecoration top={20} left={255} size={20} />
      <PlusDecoration top={45} left={180} size={20} />
      <PlusDecoration top={45} left={205} size={20} />
      <PlusDecoration top={45} left={230} size={20} />

      <PlusDecoration top={20} right={180} size={20} />
      <PlusDecoration top={20} right={205} size={20} />
      <PlusDecoration top={20} right={230} size={20} />
      <PlusDecoration top={45} right={180} size={20} />
      <PlusDecoration top={45} right={205} size={20} />
      <PlusDecoration top={45} right={230} size={20} />
      <PlusDecoration top={70} right={205} size={20} />
      <PlusDecoration top={70} right={230} size={20} />
      <PlusDecoration top={95} right={205} size={20} />
    </div>

    <!-- Mobile Version -->
    <div class="block lg:hidden">
      <ContentBox
        top={20}
        left={20}
        barcode={true}
        text={"SYS LVL.............70%" +
          "\nSTATS................20%" +
          "\nCOOLING LVL...30%" +
          "\nDAEMON...........40%"}
      />
    </div>

    <!-- We create some lines for filler -->
    <div
      class="absolute h-px bg-(--primary) pointer-events-none flex items-center justify-center top-46 left-5 w-50"
    >
    </div>
    <div
      class="absolute md:block hidden h-40 bg-(--primary) pointer-events-none items-center justify-center top-90 left-10 w-px 2xl:h-85"
    >
    </div>
    <div
      class="absolute md:block hidden h-30 bg-(--primary) pointer-events-none items-center justify-center top-48 left-16 w-px"
    >
    </div>
    <div
      class="absolute md:block hidden h-20 bg-(--primary) pointer-events-none items-center justify-center top-58 left-18 w-px"
    >
    </div>
    <div
      class="absolute md:h-14 h-30 bg-(--primary) pointer-events-none items-center justify-center top-25 left-45 md:top-48 md:left-20 w-px"
    >
    </div>

    <!-- A custom component that generates a barcode -->
    <div class="md:block hidden">
      <Barcode top={230} left={-10} rotated={true} />
    </div>

    <!-- Two navigators to point downwards -->
    <a
      class="md:block hidden absolute w-2 h-8 [clip-path:polygon(0%_0%,100%_0%,100%_50%,50%_100%,0%_50%)] top-78 left-9 bg-(--secondary)"
      href="#projects"
    >
    </a>
    <a
      class="md:block hidden absolute w-2 h-8 z-2 [clip-path:polygon(0%_0%,100%_0%,100%_50%,50%_100%,0%_50%)] top-78 right-5 bg-(--secondary)"
      href="#projects"
    >
    </a>

    <!-- Using divs we create some squares for UI -->
    <div
      class="sm:hidden xl:block absolute w-4 h-4 aspect-square bottom-24 2xl:bottom-50 right-8 bg-(--primary)"
    >
    </div>
    <div
      class="sm:hidden xl:block absolute w-4 h-4 aspect-square border-2 border-(--primary)
      bottom-24 2xl:bottom-50 right-13"
    >
    </div>
    <div
      class="sm:hidden xl:block absolute w-4 h-4 aspect-square border-2 border-dashed border-(--primary)
      bottom-24 2xl:bottom-50 right-18"
    >
    </div>
    <div
      class="sm:hidden xl:block absolute w-4 h-4 aspect-square border-2 border-dashed border-(--primary)
      bottom-24 2xl:bottom-50 right-23 flex items-center justify-center"
    >
      <div
        class="absolute left-1/2 top-1/2 size-1 -translate-x-1/2 -translate-y-1/2 bg-(--primary) rounded-full"
      >
      </div>
    </div>
    <div
      class="sm:hidden xl:block absolute w-4 h-4 aspect-square border-2 border-(--primary) bottom-24 2xl:bottom-50 right-28
      flex items-center justify-center"
    >
      <div
        class="absolute left-1/2 top-1/2 size-1 -translate-x-1/2 -translate-y-1/2 bg-(--primary) rounded-full"
      >
      </div>
    </div>

    <!-- A div containing a gradient of infinite 1px circles -->
    <div
      class="absolute left-5 bottom-0 md:bottom-10 md:left-80 2xl:left-120 w-12/13 h-48
      bg-[radial-gradient(var(--primary)_1px,transparent_1px)] bg-size-[30px_30px]
      md:w-1/4 md:h-16 md:bg-[radial-gradient(var(--primary)_1px,transparent_1px)] md:bg-size-[8px_8px]"
    >
    </div>

    <!-- The text being displayed on the hero page -->
    <h1
      class="font-bold leading-[0.95] z-3 text-(--secondary) text-(length:--font-size-heading) 2xl:text-[7rem]"
    >
      AKSHAAN<br />SINGH
    </h1>
    <h3
      class="font-bold z-3 text-(--text) pb-2 text-(length:--font-size-subheading) 2xl:text-[3rem]"
    >
      // FULL STACK ENGINEER
    </h3>
    <h2
      class="select-none -top-60 -right-6 text-[6rem] md:-top-200 md:-right-16 opacity-20 md:block md:text-[12rem]"
    >
      PORTFOLIO
    </h2>
    <h2
      class="select-none md:block hidden text-[2rem] md:top-5 md:right-5 md:text-[4rem]"
    >
      PORTFOLIO
    </h2>
    <h2
      class="select-none top-30 right-8 text-[1.5rem] md:top-5 md:right-25 md:text-[2rem]"
    >
      AKSHAAN SINGH
    </h2>

    <!-- A custom made button with some decorative UI elements -->
    <!-- CTA cluster: one anchor, children positioned inside it -->
    <div
      class="absolute right-0 bottom-5 h-16 w-48
         md:right-7 md:bottom-15 md:h-21 md:w-60
         xl:right-77"
    >
      <!-- Chevron -->
      <div
        class="absolute right-0 bottom-0 h-12 w-20 bg-(--primary)
           [clip-path:polygon(0%_80%,40%_80%,62%_0%,72%_20%,50%_100%,10%_100%)]
           md:h-20 md:w-30
           md:[clip-path:polygon(0%_80%,40%_80%,60%_0%,70%_20%,50%_100%,10%_100%)]"
      >
      </div>

      <!-- Slanted Tab -->
      <div
        class="absolute right-38 bottom-4 h-12 w-10 bg-(--primary)
           [clip-path:polygon(50%_0%,90%_0%,40%_100%,0%_100%)]
           md:right-48 md:bottom-5 md:h-16 md:w-12
           md:[clip-path:polygon(50%_0%,100%_0%,50%_100%,0%_100%)]"
      >
      </div>

      <!-- Button -->
      <button
        class="absolute right-7 bottom-4 z-6 h-12 w-36
           md:right-13 md:bottom-5 md:h-16 md:w-40 md:text-[1.5rem]
           [clip-path:polygon(15%_0%,100%_0%,85%_100%,0%_100%)]
           bg-(--primary) hover:bg-[#7031CE] text-(--text) hover:text-[#F4EEFFC2]
           font-extrabold font-(family-name:--font-heading) text-shadow-md drop-shadow-md
           flex justify-center items-center text-[1rem]"
        onclick="document.getElementById('projects').scrollIntoView({ behavior: 'smooth' })"
        >[ENTER]</button
      >
    </div>

    <!-- Some filler text to be displayed as part of the UI -->
    <div
      class="absolute top-50 left-5 flex flex-col items-start border border-(--primary) bg-black/70 p-2 md:hidden xl:contents"
    >
      <div
        class="pointer-events-none text-(--primary) font-extrabold text-xl
        md:absolute md:bottom-40 md:right-40 md:top-auto md:left-auto 2xl:right-10"
      >
        SYS//ON
      </div>
      <div
        class="pointer-events-none text-(--primary) font-extrabold text-lg
        md:absolute md:bottom-35 md:right-40 md:top-auto md:left-auto 2xl:right-10"
      >
        20.77.26
      </div>
      <div
        class="pointer-events-none text-(--primary) font-extrabold text-md
        md:absolute md:bottom-30 md:right-40 md:top-auto md:left-auto 2xl:right-10"
      >
        DIAGNOSTICS RUN
      </div>
      <div
        class="pointer-events-none text-(--primary) font-extrabold text-md
        md:absolute md:bottom-25 md:right-40 md:top-auto md:left-auto 2xl:right-10"
      >
        RENDER POSITIVE
      </div>
      <div
        class="pointer-events-none text-(--primary) font-extrabold text-md
        md:absolute md:bottom-20 md:right-40 md:top-auto md:left-auto 2xl:right-10"
      >
        TERMINAL ONLINE
      </div>
      <div
        class="pointer-events-none text-(--primary) font-extrabold text-md
        md:absolute md:bottom-15 md:right-40 md:top-auto md:left-auto 2xl:right-10"
      >
        CPU CHECKED
      </div>
    </div>

    <!-- Additional text for mobile only -->

    <div
      class="bottom-10 left-0 text-(--primary) font-extrabold text-[1rem] block sm:hidden"
    >
      // INIT_SEQUENCE
    </div>
    <div
      class="bottom-0 left-0 text-(--primary) font-extrabold text-[1rem] block sm:hidden"
    >
      NODE_CHANGE_DETECTED
    </div>
  </div>
</div>

<!-- Futuristic Page Divider -->
<div
  class="h-30 w-full bg-(--grid)
           [clip-path:polygon(0%_0%,0%_20%,10%_20%,20%_40%,40%_40%,50%_30%,70%_30%,70%_50%,90%_30%,100%_30%,100%_0%)]"
>
</div>

<style>
  h1,
  h3 {
    font-family: var(--font-heading);
  }

  h2 {
    position: absolute;
    font-family: var(--font-heading);
    font-weight: bold;
    writing-mode: vertical-rl;
    text-orientation: mixed;
  }
</style>
