---
import PlusDecoration from "../stylization/Plus.astro";
---

<div
  id="home"
  class="min-h-screen bg-[url('/night-city-bg.jpg')] bg-cover bg-center text-shadow-lg/30"
>
  <div
    class="relative flex min-h-screen flex-col items-start justify-end box-border bg-linear-to-r from-black to-transparent p-16"
  >
    <h1 class="font-bold text-(--secondary) text-(length:--font-size-heading)">
      AKSHAAN<br />SINGH
    </h1>
    <h3 class="font-bold text-(--text) text-(length:--font-size-subheading)">
      // FULL STACK ENGINEER
    </h3>
    <h2 class="text-[12rem] -top-190 -right-16 opacity-30">PORTFOLIO</h2>
    <h2 class="text-[4rem] top-5 right-5">PORTFOLIO</h2>
    <h2 class="text-[2rem] top-5 right-25">AKSHAAN SINGH</h2>

    <PlusDecoration top={50} left={65} size={20} />
    <PlusDecoration top={50} left={90} size={20} />
    <PlusDecoration top={50} left={115} size={20} />
    <PlusDecoration top={50} left={140} size={20} />
    <PlusDecoration top={75} left={65} size={20} />
    <PlusDecoration top={75} left={90} size={20} />
    <PlusDecoration top={75} left={115} size={20} />
  </div>
</div>

<style>
  h1,
  h3 {
    font-family: var(--font-heading);
  }

  h2 {
    position: absolute;
    font-family: var(--font-heading);
    font-weight: bold;
    writing-mode: vertical-rl;
    text-orientation: mixed;
  }
</style>
