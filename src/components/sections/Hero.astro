---
import PlusDecoration from "../stylization/Plus.astro";
import ContentBox from "../stylization/ContentBox.astro";
import Barcode from "../stylization/Barcode.astro";
---

<div
  id="home"
  class="min-h-screen bg-[url('/night-city-bg.jpg')] bg-cover bg-center text-shadow-lg/30"
>
  <div
    class="relative box-border flex min-h-screen flex-col items-start justify-end bg-linear-to-r from-black to-black/55 p-3 pb-18 md:p-16"
  >
    <ContentBox
      top={20}
      left={20}
      barcode={true}
      text={"SYS LVL.............70%" +
        "\nSTATS................20%" +
        "\nCOOLING LVL...30%" +
        "\nDAEMON...........40%"}
    />

    <PlusDecoration top={20} left={180} size={20} />
    <PlusDecoration top={20} left={205} size={20} />
    <PlusDecoration top={20} left={230} size={20} />
    <PlusDecoration top={20} left={255} size={20} />
    <PlusDecoration top={45} left={180} size={20} />
    <PlusDecoration top={45} left={205} size={20} />
    <PlusDecoration top={45} left={230} size={20} />

    <PlusDecoration top={20} right={180} size={20} />
    <PlusDecoration top={20} right={205} size={20} />
    <PlusDecoration top={20} right={230} size={20} />
    <PlusDecoration top={45} right={180} size={20} />
    <PlusDecoration top={45} right={205} size={20} />
    <PlusDecoration top={45} right={230} size={20} />
    <PlusDecoration top={70} right={205} size={20} />
    <PlusDecoration top={70} right={230} size={20} />
    <PlusDecoration top={95} right={205} size={20} />

    <div
      class="absolute h-px bg-(--primary) pointer-events-none flex items-center justify-center top-46 left-5 w-50"
    >
    </div>

    <Barcode top={230} left={-10} rotated={true} />

    <div
      class="absolute h-40 bg-(--primary) pointer-events-none flex items-center justify-center top-90 left-10 w-px"
    >
    </div>

    <h1
      class="font-bold leading-[0.95] text-(--secondary) text-[2.5rem] md:text-[3.5rem] lg:text-(length:--font-size-heading)"
    >
      AKSHAAN<br />SINGH
    </h1>

    <h3
      class="font-bold text-[1.25rem] text-(--text) md:text-(length:--font-size-subheading)"
    >
      // FULL STACK ENGINEER
    </h3>

    <h2
      class="-top-200 -right-16 text-[6rem] opacity-20 md:block md:text-[12rem]"
    >
      PORTFOLIO
    </h2>

    <h2 class="top-15 right-5 text-[2rem] md:top-5 md:right-5 md:text-[4rem]">
      PORTFOLIO
    </h2>

    <h2 class="top-15 right-15 text-[1rem] md:top-5 md:right-25 md:text-[2rem]">
      AKSHAAN SINGH
    </h2>
    <div
      class="sys-box pointer-events-none absolute flex items-center justify-center flex-col whitespace-pre-line px-3 py-2 text-(--primary) font-extrabold text-xl bottom-40 right-40 2xl:right-10"
    >
      SYS//ON
    </div>
    <div
      class="sys-box pointer-events-none absolute flex items-center justify-center flex-col whitespace-pre-line px-3 py-2 text-(--primary) font-extrabold text-lg bottom-35 right-40 2xl:right-10"
    >
      20.77.26
    </div>
    <div
      class="sys-box pointer-events-none absolute flex items-center justify-center flex-col whitespace-pre-line px-3 py-2 text-(--primary) font-extrabold text-md bottom-30 right-40 2xl:right-10"
    >
      DIAGNOSTICS RUN
    </div>
    <div
      class="sys-box pointer-events-none absolute flex items-center justify-center flex-col whitespace-pre-line px-3 py-2 text-(--primary) font-extrabold text-md bottom-25 right-40 2xl:right-10"
    >
      RENDER POSITIVE
    </div>
    <div
      class="sys-box pointer-events-none absolute flex items-center justify-center flex-col whitespace-pre-line px-3 py-2 text-(--primary) font-extrabold text-md bottom-20 right-40 2xl:right-10"
    >
      TERMINAL ONLINE
    </div>
    <div
      class="sys-box pointer-events-none absolute flex items-center justify-center flex-col whitespace-pre-line px-3 py-2 text-(--primary) font-extrabold text-md bottom-15 right-40 2xl:right-10"
    >
      CPU CHECKED
    </div>
  </div>
</div>

<style>
  h1,
  h3 {
    font-family: var(--font-heading);
  }

  h2 {
    position: absolute;
    font-family: var(--font-heading);
    font-weight: bold;
    writing-mode: vertical-rl;
    text-orientation: mixed;
  }
</style>
