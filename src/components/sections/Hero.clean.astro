---
import PlusDecoration from "../stylization/Plus.astro";
import ContentBox from "../stylization/ContentBox.astro";
import Barcode from "../stylization/Barcode.astro";

/* ------------------------------------------------------------------ */
/* Content                                                             */
/* ------------------------------------------------------------------ */

// Kept verbatim: the dot padding is hand-tuned to the font.
const stats = [
  "SYS LVL.............70%",
  "STATS................20%",
  "COOLING LVL...30%",
  "DAEMON...........40%",
].join("\n");

const readout = [
  "SYS//ON",
  "20.77.26",
  "DIAGNOSTICS RUN",
  "RENDER POSITIVE",
  "TERMINAL ONLINE",
  "CPU CHECKED",
];

/* ------------------------------------------------------------------ */
/* Decoration data                                                     */
/* ------------------------------------------------------------------ */

// [top, left] in px, relative to the small wrapper each cluster renders in.
// Both clusters use `left` so a 0 offset can never be dropped as falsy.
const plusesLeft = [
  [0, 0], [0, 25], [0, 50], [0, 75],
  [25, 0], [25, 25], [25, 50],
];
const plusesRight = [
  [0, 0], [0, 25], [0, 50],
  [25, 0], [25, 25], [25, 50],
  [50, 0], [50, 25],
  [75, 25],
];

// Thin vertical lines in the left rail (md and up).
const railLines = [
  "top-90 left-10 h-40 2xl:h-85",
  "top-48 left-16 h-30",
  "top-58 left-18 h-20",
  "top-48 left-20 h-14",
];

// Left-to-right order.
const squares = [
  { dot: true },
  { dashed: true, dot: true },
  { dashed: true },
  {},
  { filled: true },
];

const arrowShape = "[clip-path:polygon(0%_0%,100%_0%,100%_50%,50%_100%,0%_50%)]";
---

<!-- Landing / hero section -->
<section
  id="home"
  aria-label="Introduction"
  class="relative isolate w-full overflow-x-hidden bg-[url('/night-city-bg.jpg')] bg-cover bg-center text-shadow-lg/30"
>
  <!-- ============ Background layers (decorative) ============ -->
  <div
    aria-hidden="true"
    class="absolute inset-0 bg-linear-to-r from-black to-black/55"
  >
  </div>

  <!-- Big faded watermark, cropped by the right edge -->
  <span
    aria-hidden="true"
    class="pointer-events-none absolute inset-y-0 -right-2 select-none text-center font-(family-name:--font-heading) text-[clamp(6rem,16vw,12rem)] leading-none font-bold text-(--text) opacity-15 [writing-mode:vertical-rl]"
  >
    PORTFOLIO
  </span>

  <!-- Left rail: lines, barcode and scroll arrow (md and up) -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-y-0 left-0 hidden w-24 md:block"
  >
    {railLines.map((position) => (
      <div class:list={["absolute w-px bg-(--primary)", position]} />
    ))}
    <Barcode top={230} left={-10} rotated={true} />
    <a
      href="#projects"
      tabindex="-1"
      class:list={[
        "pointer-events-auto absolute top-78 left-9 h-8 w-2 bg-(--secondary)",
        arrowShape,
      ]}
    >
    </a>
  </div>

  <!-- ============ Content frame ============ -->
  <!-- Content flows top-to-bottom; nothing here depends on magic offsets. -->
  <div
    class="relative flex min-h-svh flex-col justify-between gap-10 px-4 py-6 sm:px-6 md:py-12 md:pr-12 md:pl-24"
  >
    <!-- ---------- Top row ---------- -->
    <div class="flex items-start justify-between gap-4">
      <!-- Left: stats box (+ status readout on small screens) -->
      <div class="flex items-start gap-4">
        <div class="flex flex-col gap-3">
          <!-- The bottom border is the line under the box -->
          <div class="relative h-44 w-52 border-b border-(--primary)">
            <ContentBox top={0} left={0} barcode={true} text={stats} />
          </div>

          <ul
            class="w-fit border border-(--primary) bg-black/70 p-2 text-sm font-extrabold text-(--primary) md:hidden"
          >
            {readout.map((line) => <li>{line}</li>)}
          </ul>
        </div>

        <div class="relative hidden h-[45px] w-[95px] lg:block" aria-hidden="true">
          {plusesLeft.map(([top, left]) => (
            <PlusDecoration top={top} left={left} size={20} />
          ))}
        </div>
      </div>

      <!-- Right: plus cluster + vertical labels -->
      <div class="flex items-start gap-12">
        <div class="relative hidden h-[95px] w-[70px] lg:block" aria-hidden="true">
          {plusesRight.map(([top, left]) => (
            <PlusDecoration top={top} left={left} size={20} />
          ))}
        </div>

        <div
          aria-hidden="true"
          class="flex items-start gap-4 font-(family-name:--font-heading) font-bold text-(--text) select-none"
        >
          <span class="text-2xl [writing-mode:vertical-rl] md:text-3xl">
            AKSHAAN SINGH
          </span>
          <div class="hidden flex-col items-center gap-4 md:flex">
            <span class="text-[4rem] [writing-mode:vertical-rl]">PORTFOLIO</span>
            <a
              href="#projects"
              tabindex="-1"
              class:list={["h-8 w-2 bg-(--secondary)", arrowShape]}
            >
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- ---------- Bottom row ---------- -->
    <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:gap-8">
      <!-- Title -->
      <div class="lg:shrink-0">
        <h1
          class="font-(family-name:--font-heading) text-[clamp(3rem,13vw,4.5rem)] leading-[0.95] font-bold text-(--secondary) lg:text-(length:--font-size-heading) 2xl:text-[7rem]"
        >
          AKSHAAN<br />SINGH
        </h1>
        <p
          class="mt-2 font-(family-name:--font-heading) text-[clamp(1.25rem,5vw,2rem)] font-bold text-(--text) lg:text-(length:--font-size-subheading) 2xl:text-[3rem]"
        >
          // FULL STACK ENGINEER
        </p>
      </div>

      <!-- Dot grid: full-width strip on small screens, fills the gap on lg+ -->
      <div
        aria-hidden="true"
        class="h-10 w-full bg-[radial-gradient(var(--primary)_1px,transparent_1px)] bg-size-[8px_8px] lg:h-16 lg:min-w-0 lg:flex-1"
      >
      </div>

      <!-- Actions -->
      <div
        class="flex flex-col items-end gap-4 md:flex-row md:justify-end lg:gap-8"
      >
        <!-- Status readout (xl and up). Below xl the same info lives in the top row. -->
        <ul
          aria-hidden="true"
          class="hidden text-right leading-snug font-extrabold text-(--primary) xl:block"
        >
          {readout.map((line, i) => (
            <li class:list={[i === 0 && "text-xl", i === 1 && "text-lg"]}>
              {line}
            </li>
          ))}
        </ul>

        <!-- CTA -->
        <div class="relative h-16 w-48 shrink-0 md:h-21 md:w-60">
          <div
            aria-hidden="true"
            class="absolute right-0 bottom-0 h-12 w-20 bg-(--primary) [clip-path:polygon(0%_80%,40%_80%,60%_0%,70%_20%,50%_100%,10%_100%)] md:h-20 md:w-30"
          >
          </div>
          <div
            aria-hidden="true"
            class="absolute right-38 bottom-4 h-12 w-10 bg-(--primary) [clip-path:polygon(50%_0%,100%_0%,50%_100%,0%_100%)] md:right-48 md:bottom-5 md:h-16 md:w-12"
          >
          </div>
          <a
            href="#projects"
            class="absolute right-7 bottom-4 z-10 flex h-12 w-36 items-center justify-center bg-(--primary) font-(family-name:--font-heading) text-base font-extrabold text-(--text) drop-shadow-md text-shadow-md [clip-path:polygon(15%_0%,100%_0%,85%_100%,0%_100%)] hover:bg-[#7031CE] hover:text-[#F4EEFFC2] focus-visible:bg-[#7031CE] focus-visible:text-[#F4EEFFC2] md:right-13 md:bottom-5 md:h-16 md:w-40 md:text-2xl"
          >
            [ENTER]
          </a>
        </div>

        <!-- Square indicators (lg and up) -->
        <div aria-hidden="true" class="hidden gap-1 lg:flex">
          {squares.map(({ filled, dashed, dot }) => (
            <div
              class:list={[
                "grid size-4 place-items-center",
                filled ? "bg-(--primary)" : "border-2 border-(--primary)",
                dashed && "border-dashed",
              ]}
            >
              {dot && <div class="size-1 rounded-full bg-(--primary)" />}
            </div>
          ))}
        </div>

        <!-- Small-screen flavour text -->
        <div
          aria-hidden="true"
          class="self-start text-xs font-extrabold text-(--primary) sm:text-sm md:hidden"
        >
          <p>// INIT_SEQUENCE</p>
          <p>NODE_CHANGE_DETECTED</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Jagged divider into the next section -->
<div
  aria-hidden="true"
  class="h-30 w-full bg-(--grid) [clip-path:polygon(0%_0%,0%_20%,10%_20%,20%_40%,40%_40%,50%_30%,70%_30%,70%_50%,90%_30%,100%_30%,100%_0%)]"
>
</div>
