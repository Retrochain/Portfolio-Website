---
import { Astronav, MenuItems, MenuIcon } from "astro-navbar";
---

<div id="site-navbar">
  <Astronav closeOnClick>
    <div class="fixed right-4 top-2 z-70 flex justify-end px-3 py-2 md:hidden">
      <div
        data-augmented-ui="tl-clip br-clip border"
        class="navbar-toggle flex h-12 w-12 items-center justify-center bg-[#08050d]"
      >
        <MenuIcon class="h-7 w-7 text-(--secondary)" />
      </div>
    </div>
    <MenuItems
      class="hidden fixed inset-0 z-60 min-h-dvh w-full items-center justify-center
       bg-black/65 backdrop-blur-md md:inset-x-0 md:top-0 md:bottom-auto md:z-60
       md:min-h-0 md:items-start md:justify-center md:bg-transparent md:backdrop-blur-none
       md:text-[1rem] lg:text-(length:--font-size-nav) font-semibold text-shadow-md md:flex"
    >
      <div
        data-augmented-ui="bl-clip br-clip-y border"
        class="navbar-panel w-[calc(100%-2rem)] max-w-xl bg-transparent md:w-max md:max-w-none md:bg-[#08050d]"
      >
        <ul
          class="flex w-full flex-col items-center justify-center gap-3 px-6 py-8 md:w-max md:flex-row md:flex-nowrap md:gap-x-6 md:px-8 md:py-3"
        >
          <li class="whitespace-nowrap"><a href="#home">//HOME</a></li>
          <li class="whitespace-nowrap"><a href="#projects">//PROJECTS</a></li>
          <li class="whitespace-nowrap"><a href="#about">//ABOUT</a></li>
          <li class="whitespace-nowrap"><a href="#skills">//SKILLS</a></li>
          <li class="whitespace-nowrap"><a href="#contact">//CONTACT</a></li>
        </ul>
      </div>
    </MenuItems>
  </Astronav>
</div>

<script>
  const links = [
    ...document.querySelectorAll<HTMLAnchorElement>(".astronav-items a"),
  ];

  const sections = links
    .map((link) => document.querySelector(link.hash))
    .filter((section): section is Element => section !== null);

  const setActive = (id: string) => {
    links.forEach((link) => {
      const active = link.hash === `#${id}`;

      link.classList.toggle("active", active);

      if (active) link.setAttribute("aria-current", "page");
      else link.removeAttribute("aria-current");
    });
  };

  setActive(sections[0]?.id ?? "");

  const observer = new IntersectionObserver(
    (entries) => {
      const visible = entries
        .filter((entry) => entry.isIntersecting)
        .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];

      if (visible) setActive(visible.target.id);
    },
    { rootMargin: "-20% 0px -60% 0px" },
  );

  sections.forEach((section) => observer.observe(section));
</script>

<style>
  .navbar-panel {
    --aug-border-all: 2px;
    --aug-border-bg: var(--secondary);
  }

  @media (max-width: 767px) {
    .navbar-panel {
      --aug-border: 0px;
    }
  }

  .navbar-toggle {
    --aug-border-all: 1px;
    --aug-border-bg: var(--secondary);
  }

  nav {
    font-family: var(--font-main);
  }

  nav:first-of-type a {
    transition:
      color 150ms ease,
      text-shadow 150ms ease;
  }

  nav:first-of-type a.active {
    color: var(--secondary);
    text-shadow: 0 0 12px var(--secondary);
  }
</style>
