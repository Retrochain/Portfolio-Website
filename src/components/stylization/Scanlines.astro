<!-- A simple div to create scanlines using css -->
<div class="scanlines fixed inset-0 pointer-events-none z-50" aria-hidden="true"></div>

<style>
  /*Using CSS, we create repeating horizontal lines that simulate scanlines*/
  .scanlines {
    background: repeating-linear-gradient(
      to bottom,
      var(--scanlines) 0px,
      var(--scanlines) 1px,
      transparent 1px,
      transparent 4px
    );
  }

  /*Using CSS, we create a pseudo=element to create a moving scanline to give the effect of old CRT monitors*/
  .scanlines::after {
    content: "";
    position: absolute;

    left: 0;
    right: 0;

    height: 1px;

    background: rgba(168, 85, 247, 0.6);
    box-shadow:
      0 0 8px rgba(125, 60, 185, 0.11),
      0 0 20px rgba(168, 85, 247, 0.199);

    animation: scanline 6s linear infinite;
  }

  /*We also animate the scanline so that it travels top to bottom*/
  @keyframes scanline {
    from {
      top: -2px;
    }

    to {
      top: 100%;
    }
  }
</style>
