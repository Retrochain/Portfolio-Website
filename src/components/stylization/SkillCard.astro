---
interface Props {
  title: string;
  list: string[];
}

const { title, list } = Astro.props;
---

<div class="flex flex-col min-w-0">
  <div
    data-augmented-ui="tr-clip border"
    class="bio-header flex min-h-10 w-4/5 sm:w-4/5 md:w-5/7 lg:w-3/5 items-center px-4 py-2 text-xl font-extrabold text-(--secondary) leading-tight bg-(--grid)/60"
  >
    {title}
  </div>
  <div
    class="flex flex-col min-h-0 border border-(--primary)/60 bg-(--grid)/40 p-5 text-xl font-bold wrap-break-word"
  >
    {list.map((item) => <div>- {item}</div>)}
  </div>
</div>

<style>
  .bio-header {
    --aug-border-all: 1px;
    --aug-border-bg: color-mix(in srgb, var(--primary) 60%, transparent);
  }
</style>
