---
const {
  img,
  gif,
  border,
  title,
  description,
  color = "var(--secondary)",
} = Astro.props;
---

<div
  class="grid grid-cols-[2rem_minmax(0,1fr)] gap-x-1 gap-y-1"
  style={`--display-color: ${color}`}
>
  <div
    data-augmented-ui={border}
    class="project-border-main col-start-1 row-start-1 w-full h-full bg-(--display-color)/40 pb-2"
  >
  </div>
  <div
    class="group relative col-start-2 row-start-1 min-w-0 w-full border border-(--display-color)/60 bg-black/30 overflow-hidden"
  >
    <img
      src={img}
      alt={title}
      class="sm:block hidden w-full h-auto"
    />
    <img
      src={gif}
      alt={title}
      class="block w-full h-auto sm:absolute sm:inset-0 sm:w-full sm:h-full sm:object-contain sm:opacity-0 sm:transition-opacity sm:duration-300 sm:group-hover:opacity-100"
    />
  </div>
  <div
    data-augmented-ui="bl-clip border"
    class="project-border-sub col-start-1 row-start-2 w-full h-8 bg-(--display-color)/40 pb-4 mb-8"
  >
  </div>
  <div
    class="col-start-2 row-start-2 flex items-center justify-center border border-(--display-color)/60 bg-(--secondary)/90 px-2 mb-8 text-black font-bold"
  >
    {description}
  </div>
</div>

<style>
  .project-border-main {
    --aug-border-all: 2px;
    --aug-border-bg: var(--display-color);
  }

  .project-border-sub {
    --aug-border-all: 2px;
    --aug-border-bg: var(--display-color);
  }
</style>
