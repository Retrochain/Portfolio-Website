---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Scanlines from "../components/stylization/Scanlines.astro";
---

<!-- 
    This is the layout page for the website. Content placed here will be displayed on every page of the website.
    The <slot /> tag is used to display the content of the page that uses this layout.
--><!doctype html>
<html lang="en" class="no-scrollbar">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.png" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Akshaan Singh's Portfolio Website</title>
  </head>
  <body class="no-scrollbar">
    <Scanlines />
    <Navbar />
    <slot />
  </body>
</html>
