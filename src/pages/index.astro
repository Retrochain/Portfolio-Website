---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/sections/Hero.astro';
import Projects from '../components/sections/Projects.astro';
import About from '../components/sections/About.astro';
import Skills from '../components/sections/Skills.astro';
import Contact from '../components/sections/Contact.astro';
---

<!-- 
	This is the main page of the website. It uses the Layout component to render a consistent layout across all pages.
	The content placed inside the <Layout> component will be displayed in the <slot /> of the Layout component.
-->
<Layout>
	<Hero />
	<Projects />
	<About />
	<Skills />
	<Contact />
</Layout>
